# ---------- PRODUCTION ----------
FROM node:20-alpine

WORKDIR /client

COPY package*.json ./
RUN npm install

COPY . .

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=80

ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL
ENV VITE_BACKEND_PROTOCOL=$VITE_BACKEND_PROTOCOL
ENV VITE_KEYCLOAK_PROTOCOL=$VITE_KEYCLOAK_PROTOCOL
ENV VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM

RUN npm run build

CMD ["npx", "vite", "preview", "--port", "80", "--host"]